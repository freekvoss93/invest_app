# DeGiro Credentials
DEGIRO_USERNAME=your_username
DEGIRO_PASSWORD=your_password

# Optional: TOTP secret for 2FA (if enabled on your account)
# DEGIRO_TOTP_SECRET=your_totp_secret

# Database path (default: portfolio.db in project root)
# DB_PATH=portfolio.db

# Schedule time for daily retrieval (24h format, default: 18:00)
# SCHEDULE_HOUR=18
# SCHEDULE_MINUTE=0
